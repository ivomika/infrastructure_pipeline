ARG JENKINS_AGENT_BASE_IMAGE=agent-base
FROM ${JENKINS_AGENT_BASE_IMAGE}

ARG MAVEN_ARCHIVE_SHA512
ARG MAVEN_URL
ARG MAVEN_VERSION
ARG SOURCE_DATE_EPOCH

ENV MAVEN_HOME=/opt/maven \
    MAVEN_CONFIG=/home/jenkins/.m2 \
    PATH=/opt/maven/bin:${PATH} \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

USER root

RUN curl --fail --location --retry 3 \
        "${MAVEN_URL}" \
        --output /tmp/maven.tar.gz \
    && echo "${MAVEN_ARCHIVE_SHA512}  /tmp/maven.tar.gz" | sha512sum --check - \
    && mkdir -p "${MAVEN_HOME}" \
    && tar --extract --gzip --file /tmp/maven.tar.gz \
        --directory "${MAVEN_HOME}" \
        --strip-components=1 \
    && rm /tmp/maven.tar.gz \
    && mkdir -p "${MAVEN_CONFIG}" /home/jenkins/.gradle \
    && chown -R jenkins:jenkins \
        /home/jenkins \
        "${MAVEN_HOME}"

USER jenkins

RUN java -version \
    && javac -version \
    && mvn --version
