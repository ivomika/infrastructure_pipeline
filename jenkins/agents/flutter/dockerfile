ARG JENKINS_AGENT_BASE_IMAGE=agent-base
FROM ${JENKINS_AGENT_BASE_IMAGE}

ARG ANDROID_BUILD_TOOLS_VERSION
ARG ANDROID_COMMAND_LINE_TOOLS_SHA1
ARG ANDROID_COMMAND_LINE_TOOLS_SHA256
ARG ANDROID_COMMAND_LINE_TOOLS_URL
ARG ANDROID_COMMAND_LINE_TOOLS_VERSION
ARG ANDROID_PLATFORM_VERSION
ARG FLUTTER_ARCHIVE_SHA256
ARG FLUTTER_URL
ARG FLUTTER_VERSION
ARG LIBGLU1_MESA_VERSION
ARG LIBSQLITE3_DEV_VERSION
ARG SOURCE_DATE_EPOCH

ENV FLUTTER_HOME=/sdks/flutter \
    FLUTTER_ROOT=/sdks/flutter \
    ANDROID_HOME=/opt/android-sdk-linux \
    ANDROID_SDK_ROOT=/opt/android-sdk-linux \
    PUB_CACHE=/home/jenkins/.pub-cache \
    GRADLE_USER_HOME=/home/jenkins/.gradle \
    FLUTTER_VERSION=${FLUTTER_VERSION} \
    ANDROID_PLATFORM_VERSION=${ANDROID_PLATFORM_VERSION} \
    ANDROID_BUILD_TOOLS_VERSION=${ANDROID_BUILD_TOOLS_VERSION} \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} \
    LANG=C.UTF-8

USER root

RUN apt-get -o Acquire::Check-Valid-Until=false update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        "libglu1-mesa=${LIBGLU1_MESA_VERSION}" \
        "libsqlite3-dev=${LIBSQLITE3_DEV_VERSION}" \
    && rm -rf \
        /var/cache/apt/archives/* \
        /var/lib/apt/lists/* \
        /var/log/apt/* \
    && rm -f /var/log/dpkg.log

RUN mkdir -p /sdks /opt/android-sdk-linux/cmdline-tools \
    && curl --fail --location --retry 3 \
        "${FLUTTER_URL}" \
        --output /tmp/flutter.tar.xz \
    && echo "${FLUTTER_ARCHIVE_SHA256}  /tmp/flutter.tar.xz" | sha256sum --check - \
    && tar --extract --xz --file /tmp/flutter.tar.xz --directory /sdks \
    && rm /tmp/flutter.tar.xz \
    && git config --system --add safe.directory /sdks/flutter

RUN curl --fail --location --retry 3 \
        "${ANDROID_COMMAND_LINE_TOOLS_URL}" \
        --output /tmp/android-command-line-tools.zip \
    && echo "${ANDROID_COMMAND_LINE_TOOLS_SHA256}  /tmp/android-command-line-tools.zip" | sha256sum --check - \
    && echo "${ANDROID_COMMAND_LINE_TOOLS_SHA1}  /tmp/android-command-line-tools.zip" | sha1sum --check - \
    && unzip -q /tmp/android-command-line-tools.zip -d /tmp/android-command-line-tools \
    && mv /tmp/android-command-line-tools/cmdline-tools /opt/android-sdk-linux/cmdline-tools/latest \
    && rm -rf /tmp/android-command-line-tools /tmp/android-command-line-tools.zip

ENV PATH="${FLUTTER_HOME}/bin:${FLUTTER_HOME}/bin/cache/dart-sdk/bin:${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin:${ANDROID_SDK_ROOT}/platform-tools:${ANDROID_SDK_ROOT}/emulator:${PUB_CACHE}/bin:${PATH}"

RUN yes | sdkmanager --sdk_root="${ANDROID_SDK_ROOT}" --licenses >/dev/null \
    && sdkmanager --sdk_root="${ANDROID_SDK_ROOT}" \
        "platform-tools" \
        "platforms;android-${ANDROID_PLATFORM_VERSION}" \
        "build-tools;${ANDROID_BUILD_TOOLS_VERSION}" \
    && mkdir -p "${PUB_CACHE}" "${GRADLE_USER_HOME}" \
    && mkdir -p /usr/lib/jvm \
    && if [ ! -e /usr/lib/jvm/java-21-openjdk-amd64 ]; then \
        ln -s "${JAVA_HOME}" /usr/lib/jvm/java-21-openjdk-amd64; \
    fi \
    && chown -R jenkins:jenkins \
        /home/jenkins \
        /sdks/flutter \
        /opt/android-sdk-linux

USER jenkins

RUN flutter config --no-analytics \
    && flutter precache --android --web \
    && flutter --version \
    && dart --version \
    && java -version \
    && flutter doctor --verbose
