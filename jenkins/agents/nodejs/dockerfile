ARG JENKINS_AGENT_BASE_IMAGE=agent-base
FROM ${JENKINS_AGENT_BASE_IMAGE}

ARG GCC_VERSION
ARG GXX_VERSION
ARG MAKE_VERSION
ARG NODE_LINUX_ARM64_SHA256
ARG NODE_LINUX_ARM64_URL
ARG NODE_LINUX_X64_SHA256
ARG NODE_LINUX_X64_URL
ARG NODE_VERSION
ARG PYTHON3_VERSION
ARG SOURCE_DATE_EPOCH
ARG TARGETARCH

ENV NODE_HOME=/opt/node \
    NPM_CONFIG_CACHE=/home/jenkins/.npm \
    PATH=/opt/node/bin:${PATH} \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

USER root

RUN apt-get -o Acquire::Check-Valid-Until=false update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        "gcc=${GCC_VERSION}" \
        "g++=${GXX_VERSION}" \
        "make=${MAKE_VERSION}" \
        "python3=${PYTHON3_VERSION}" \
    && rm -rf \
        /var/cache/apt/archives/* \
        /var/lib/apt/lists/* \
        /var/log/apt/* \
    && rm -f /var/log/dpkg.log

RUN case "${TARGETARCH}" in \
        amd64) node_url="${NODE_LINUX_X64_URL}"; node_sha256="${NODE_LINUX_X64_SHA256}" ;; \
        arm64) node_url="${NODE_LINUX_ARM64_URL}"; node_sha256="${NODE_LINUX_ARM64_SHA256}" ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl --fail --location --retry 3 \
        "${node_url}" \
        --output /tmp/node.tar.xz \
    && echo "${node_sha256}  /tmp/node.tar.xz" | sha256sum --check - \
    && mkdir -p "${NODE_HOME}" \
    && tar --extract --xz --file /tmp/node.tar.xz \
        --directory "${NODE_HOME}" \
        --strip-components=1 \
    && rm /tmp/node.tar.xz \
    && mkdir -p "${NPM_CONFIG_CACHE}" \
    && chown -R jenkins:jenkins /home/jenkins "${NODE_HOME}"

USER jenkins

RUN node --version \
    && npm --version \
    && python3 --version \
    && make --version \
    && g++ --version

RUN --mount=type=bind,source=smoke/node-gyp,target=/tmp/node-gyp-source,readonly \
    mkdir -p /home/jenkins/node-gyp-smoke \
    && cp -R /tmp/node-gyp-source/. /home/jenkins/node-gyp-smoke/ \
    && node "$(npm root --global)/npm/node_modules/node-gyp/bin/node-gyp.js" \
        rebuild \
        --directory /home/jenkins/node-gyp-smoke \
        --nodedir "${NODE_HOME}" \
    && node -e "const addon = require('/home/jenkins/node-gyp-smoke/build/Release/smoke.node'); if (addon.answer() !== 42) process.exit(1)" \
    && rm -rf /home/jenkins/node-gyp-smoke
