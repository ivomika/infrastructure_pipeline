ARG JENKINS_INBOUND_AGENT_IMAGE=jenkins/inbound-agent:3355.v388858a_47b_33-14-jdk21@sha256:0d19619d2993f0809cb080a49136832305d2d568c2dcf84705039aac5258c7fc
FROM ${JENKINS_INBOUND_AGENT_IMAGE}

ARG DEBIAN_SNAPSHOT=20260202T000000Z
ARG TARGETARCH
ARG NODE_VERSION
ARG NODE_LINUX_X64_SHA256
ARG NODE_LINUX_ARM64_SHA256

ENV NODE_HOME=/opt/node \
    NPM_CONFIG_CACHE=/home/jenkins/.npm \
    PATH=/opt/node/bin:${PATH}

USER root

RUN sed -i \
        -e "s|http://deb.debian.org/debian-security|http://snapshot.debian.org/archive/debian-security/${DEBIAN_SNAPSHOT}|" \
        -e "s|http://deb.debian.org/debian|http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT}|" \
        -e "/^Signed-By:/a Check-Valid-Until: no" \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates=20250419 \
        curl=8.14.1-2+deb13u2 \
        git=1:2.47.3-0+deb13u1 \
        xz-utils=5.8.1-1 \
    && rm -rf /var/lib/apt/lists/*

RUN case "${TARGETARCH}" in \
        amd64) node_arch="x64"; node_sha256="${NODE_LINUX_X64_SHA256}" ;; \
        arm64) node_arch="arm64"; node_sha256="${NODE_LINUX_ARM64_SHA256}" ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl --fail --location --retry 3 \
        "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" \
        --output /tmp/node.tar.xz \
    && echo "${node_sha256}  /tmp/node.tar.xz" | sha256sum --check - \
    && mkdir -p "${NODE_HOME}" \
    && tar --extract --xz --file /tmp/node.tar.xz \
        --directory "${NODE_HOME}" \
        --strip-components=1 \
    && rm /tmp/node.tar.xz \
    && mkdir -p /home/jenkins/agent "${NPM_CONFIG_CACHE}" \
    && chown -R jenkins:jenkins /home/jenkins "${NODE_HOME}"

USER jenkins

RUN node --version \
    && npm --version \
    && git --version
