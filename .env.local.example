# General
COMPOSE_PROJECT_NAME=devops-infra-local
TZ=Europe/Moscow
HOST_BIND_ADDRESS=127.0.0.1

# Jenkins
JENKINS_CONTROLLER_IMAGE=jenkins-controller:1.0.0
JENKINS_AGENT_SLAVE_IMAGE=jenkins-agent-slave:1.0.0
JENKINS_AGENT_JAVA_IMAGE=jenkins-agent-java:1.0.0
JENKINS_AGENT_NODE_IMAGE=jenkins-agent-node:1.0.0
JENKINS_AGENT_FLUTTER_IMAGE=jenkins-agent-flutter:1.0.0
JENKINS_HTTP_PORT=8080
JENKINS_URL=http://jenkins.localhost/
JENKINS_HOST=jenkins.localhost
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me

# Plane
PLANE_HTTP_PORT=8081
PLANE_WEB_URL=http://plane.localhost
PLANE_HOST=plane.localhost
PLANE_APP_DOMAIN=localhost
PLANE_SECRET_KEY=change-me-plane-secret
PLANE_LIVE_SECRET_KEY=change-me-plane-live-secret
PLANE_DB_PASSWORD=change-me-plane-db
PLANE_RABBITMQ_PASSWORD=change-me-plane-rabbitmq
PLANE_MINIO_ACCESS_KEY=plane
PLANE_MINIO_SECRET_KEY=change-me-plane-minio
PLANE_GUNICORN_WORKERS=1
PLANE_DB_MAX_CONNECTIONS=1000
PLANE_FILE_SIZE_LIMIT=5242880

# Docmost
DOCMOST_HTTP_PORT=8082
DOCMOST_APP_URL=http://docs.localhost
DOCMOST_HOST=docs.localhost
DOCMOST_APP_SECRET=change-me-docmost-app-secret-before-use
DOCMOST_DB_PASSWORD=change-me-docmost-db

# Nexus
NEXUS_HTTP_PORT=8083
NEXUS_DOCKER_PORT=5000
NEXUS_HOST=nexus.localhost
NEXUS_DOCKER_HOST=registry.localhost

# Grafana
GRAFANA_HTTP_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_HOST=grafana.localhost
GRAFANA_ROOT_URL=http://grafana.localhost/

# Nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_TEMPLATE_FILE=local.conf.template
PLANE_NGINX_MAX_BODY_SIZE=10m
DOCMOST_NGINX_MAX_BODY_SIZE=50m
NEXUS_NGINX_MAX_BODY_SIZE=0
