JENKINS_ADMIN_ID=jenkins-admin
JENKINS_ADMIN_PASSWORD=
JENKINS_HOST_ADDRESS=127.0.0.1
JENKINS_HTTP_PORT=8080
JENKINS_HOME_VOLUME=infrastructure-pipeline_jenkins_home
JENKINS_MEMORY_LIMIT=4g
JENKINS_CPU_LIMIT=2.0
JENKINS_PIDS_LIMIT=512
DOCKER_PROXY_MEMORY_LIMIT=256m
DOCKER_PROXY_CPU_LIMIT=0.50
DOCKER_PROXY_PIDS_LIMIT=128
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5
JENKINS_URL=http://127.0.0.1:8080/
JENKINS_INTERNAL_URL=http://jenkins:8080/
JENKINS_DOCKER_CLOUD_NAME=local-docker
JENKINS_DOCKER_CONTAINER_CAP=4
JENKINS_DOCKER_HOST=tcp://docker-socket-proxy:2375
JENKINS_AGENT_REMOTE_FS=/home/jenkins/agent
JENKINS_AGENT_MEMORY_MB=6144
JENKINS_AGENT_CPUS=2.0
SHARED_LIBRARY_NAME=jenkins_libs
SHARED_LIBRARY_REPOSITORY_URL=git@github.com:your-org/jenkins_libs.git
SHARED_LIBRARY_DEFAULT_BRANCH=main
SHARED_LIBRARY_CREDENTIALS_ID=jenkins-libs-git
SHARED_LIBRARY_SSH_USERNAME=git
FLUTTER_AGENT_NAME=flutter-agent
FLUTTER_AGENT_LABELS=flutter
FLUTTER_AGENT_INSTANCE_CAP=2
NODEJS_AGENT_NAME=nodejs-agent
NODEJS_AGENT_LABELS=nodejs
NODEJS_AGENT_INSTANCE_CAP=2
JAVA_AGENT_NAME=java-agent
JAVA_AGENT_LABELS=java maven backend
JAVA_AGENT_INSTANCE_CAP=2
